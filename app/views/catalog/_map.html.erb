<%# encoding: UTF-8 %>
<div id="documents" class="search-map-view">
  <% map_query_params = request.query_parameters.merge(format: :json) %>
  <% unless content_for?(:leaflet_assets) %>
    <% content_for :leaflet_assets do %>
      <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
      <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <% end %>
    <% content_for :head do %>
      <%= content_for :leaflet_assets %>
    <% end %>
  <% end %>
  <div
    id="search-results-map"
    class="search-results-map"
    data-fallback-path="<%= request.path %>"
    data-geojson-url="<%= catalog_map_geojson_path(map_query_params) %>"
    data-native-land-url="<%= native_land_territories_path %>"
    <%= Rails.configuration.x.native_land_api_key.present? ? "data-native-land-key=\"#{Rails.configuration.x.native_land_api_key}\"" : '' %>
  >
    <div class="search-map-loading" role="status">
      <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
      <span class="loading-text">Loading map data…</span>
    </div>
  </div>
</div>
